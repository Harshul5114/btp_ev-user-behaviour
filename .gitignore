# Data: preserve folder placeholders only; never version datasets by default.
/data/raw/*
/data/interim/*
/data/processed/*
!/data/raw/.gitkeep
!/data/interim/.gitkeep
!/data/processed/.gitkeep

# Generated artefacts: preserve folder placeholders only.
/outputs/*
!/outputs/.gitkeep
!/outputs/figures/
!/outputs/tables/
!/outputs/presentation/
/outputs/figures/*
/outputs/tables/*
/outputs/presentation/*
!/outputs/figures/.gitkeep
!/outputs/tables/.gitkeep
!/outputs/presentation/.gitkeep
